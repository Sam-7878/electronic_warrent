{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hete.example/schemas/machine_policy.schema.json",
  "title": "HETE Machine Policy Object",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "policy_type", "version", "issuer", "authorization_policy", "subject", "resource", "permitted_actions", "validity", "revocation", "nonce", "domain_binding", "policy_digest"],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "policy_type": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "issuer": {"$ref": "authority_policy.schema.json#/$defs/authorityRef"},
    "authorization_policy": {"$ref": "authority_policy.schema.json"},
    "subject": {"type": "object"},
    "resource": {"type": "object"},
    "permitted_actions": {"type": "array", "minItems": 1},
    "validity": {"type": "object", "required": ["not_before", "expires_at", "maximum_duration"]},
    "conditions": {"type": "array"},
    "obligations": {"type": "array"},
    "revocation": {"type": "object"},
    "evidence_refs": {"type": "array"},
    "credential_refs": {"type": "array"},
    "nonce": {"type": "string", "minLength": 1},
    "domain_binding": {"type": "object", "required": ["environment_id", "service_id", "adapter_id"], "additionalProperties": false},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
