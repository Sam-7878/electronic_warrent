{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hete.example/schemas/adapter_manifest.schema.json",
  "title": "HETE Enforcement Adapter Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter_id", "version", "supported_resources", "supported_actions", "supports_atomic_prepare_commit", "supports_amount_bounded_freeze", "supports_expiration", "supports_revocation", "authoritative_balance", "assurance"],
  "properties": {
    "adapter_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "supported_resources": {"type": "array", "minItems": 1},
    "supported_actions": {"type": "array", "minItems": 1},
    "supports_atomic_prepare_commit": {"type": "boolean"},
    "supports_amount_bounded_freeze": {"type": "boolean"},
    "supports_expiration": {"type": "boolean"},
    "supports_revocation": {"type": "boolean"},
    "authoritative_balance": {"type": "boolean"},
    "assurance": {"type": "string", "minLength": 1}
  }
}
