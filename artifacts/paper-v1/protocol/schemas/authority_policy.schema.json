{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hete.example/schemas/authority_policy.schema.json",
  "title": "Configurable Multi-Authority Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements", "threshold", "mutually_exclusive_roles", "sequential"],
  "properties": {
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["role", "minimum_signatures", "sequence"]}},
    "threshold": {"type": "integer", "minimum": 1},
    "mutually_exclusive_roles": {"type": "array"},
    "sequential": {"type": "boolean"}
  },
  "$defs": {
    "authorityRef": {"type": "object", "additionalProperties": false, "required": ["did", "role"], "properties": {"did": {"type": "string", "pattern": "^did:"}, "role": {}}}
  }
}
